# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Values come from the Supabase dashboard under Project Settings > API,
# or from `supabase projects api-keys --project-ref <ref>`.

# Safe to expose. Shipped to the browser, and protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC, never import into client code.
#
# This key bypasses row-level security entirely. PRD FR-15.8 requires that
# currency balances are only ever written server-side, which is precisely what
# this key is for and precisely why it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=
