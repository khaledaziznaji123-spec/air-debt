# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# Values come from the Supabase dashboard under Project Settings > API,
# or from `supabase projects api-keys --project-ref <ref>`.

# Safe to expose. Shipped to the browser, and protected by row-level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC, never import into client code.
#
# This key bypasses row-level security entirely. PRD FR-15.8 requires that
# currency balances are only ever written server-side, which is precisely what
# this key is for and precisely why it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- support mail
# Optional, and the support form works without them: every message is written to
# the `messages` table first and emailed second, so an absent key costs the
# notification and never the message.
#
# RESEND_API_KEY  — a free account at resend.com, server-only, never NEXT_PUBLIC_
# SUPPORT_EMAIL   — where support mail is delivered
# SUPPORT_FROM    — the sender. Resend's shared address works with no domain set up.
RESEND_API_KEY=
SUPPORT_EMAIL=
SUPPORT_FROM=
